# Configuracion de JWT requerida por la API.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Reemplazar por una clave aleatoria privada antes de usar la API.
SECRET_KEY=
ALGORITHM=HS256

# URLs para contenedores del Compose; el hostname `db` es el servicio PostgreSQL.
# Compose las construye de nuevo usando las variables POSTGRES_* anteriores.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/peibo_db
# Debe conservar el nombre `peibo_test`: las pruebas validan ese nombre y limpian sus tablas.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/peibo_test